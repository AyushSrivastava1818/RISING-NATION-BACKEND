// Prisma Schema — Rising Nation Platform (MVP Schema)
// Matches DATABASE.md Entity Specification + Server-side Sessions per ARCHITECTURE.md §3.6

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String   @unique
  password_hash String?
  role          String   @default("public") // public | member | admin
  growth_level  String?  @default("learner") // learner | contributor | intern | builder | lead
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  people_profile      PeopleProfile?
  submitted_ideas     Idea[]              @relation("IdeaSubmittedBy")
  idea_status_changes IdeaStatusHistory[] @relation("IdeaStatusActor")
  enquiries           Enquiry[]
  sessions            Session[]

  @@map("users")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @db.Uuid
  created_at     DateTime @default(now())
  expires_at     DateTime
  last_active_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

model PeopleProfile {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String?  @unique @db.Uuid
  name         String
  role_title   String
  group        String // founding | core | contributor | builder | mentor | industry | partner
  short_intro  String?  @db.Text
  skills       String[]
  linkedin_url String?
  photo_url    String?
  featured     Boolean  @default(false)

  user            User?           @relation(fields: [user_id], references: [id], onDelete: SetNull)
  project_members ProjectMember[]

  @@index([featured])
  @@map("people_profiles")
}

model Category {
  id    String  @id @default(uuid()) @db.Uuid
  name  String
  slug  String  @unique
  type  String // learning | service
  group String? // business | creator (per API.md §3)

  courses Course[]

  @@map("categories")
}

model Course {
  id             String  @id @default(uuid()) @db.Uuid
  title          String
  description    String? @db.Text
  level          String // Beginner | Intermediate | Advanced
  category_id    String  @db.Uuid
  content_source String // youtube | native
  content_ref    String // YouTube video/playlist ID or native content reference
  thumbnail_url  String?
  published      Boolean @default(true)

  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@index([category_id, published])
  @@map("courses")
}

model Project {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  client_or_category String
  problem            String   @db.Text
  solution           String   @db.Text
  technologies       String[]
  result             String?  @db.Text
  status             String // in_progress | completed
  featured           Boolean  @default(false)

  media   ProjectMedia[]
  members ProjectMember[]

  @@index([featured])
  @@map("projects")
}

model ProjectMedia {
  id         String @id @default(uuid()) @db.Uuid
  project_id String @db.Uuid
  media_url  String
  media_type String // image | video

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("project_media")
}

model ProjectMember {
  project_id        String @db.Uuid
  profile_id        String @db.Uuid
  contribution_role String

  project Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  profile PeopleProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@id([project_id, profile_id])
  @@map("project_members")
}

model Idea {
  id                   String   @id @default(uuid()) @db.Uuid
  submitted_by         String?  @db.Uuid
  title                String
  problem              String   @db.Text
  proposed_solution    String   @db.Text
  target_users         String   @db.Text
  why_it_matters       String   @db.Text
  current_stage        String
  skills_team_required String?  @db.Text
  document_url         String?
  demo_url             String?
  contact_email        String
  contact_phone        String?
  status               String   @default("submitted") // submitted | in_review | evaluated | credited | shortlisted | in_development
  version              Int      @default(1) // Optimistic locking per DATABASE.md Data Integrity
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  submitter      User?               @relation("IdeaSubmittedBy", fields: [submitted_by], references: [id], onDelete: SetNull)
  status_history IdeaStatusHistory[]

  @@index([status])
  @@map("ideas")
}

model IdeaStatusHistory {
  id          String   @id @default(uuid()) @db.Uuid
  idea_id     String   @db.Uuid
  from_status String?
  to_status   String
  actor_id    String?  @db.Uuid
  notes       String?  @db.Text
  created_at  DateTime @default(now())

  idea  Idea  @relation(fields: [idea_id], references: [id], onDelete: Cascade)
  actor User? @relation("IdeaStatusActor", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([idea_id])
  @@map("ideas_status_history")
}

model Enquiry {
  id                 String   @id @default(uuid()) @db.Uuid
  type               String // business_solutions | creator_support
  services_requested String[]
  contact_name       String
  contact_email      String
  contact_phone      String?
  message            String   @db.Text
  status             String   @default("new") // new | contacted | closed
  user_id            String?  @db.Uuid
  created_at         DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("enquiries")
}
