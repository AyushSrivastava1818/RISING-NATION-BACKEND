# Configuration — Rising Nation Platform
# Variables match ENGINEERING.md §6.9 exactly

NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/risingnation?schema=public"
SESSION_SECRET="change-this-to-a-secure-secret-in-production"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"
S3_ENDPOINT="https://s3.amazonaws.com"
S3_BUCKET="risingnation-media"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
YOUTUBE_API_KEY="your-youtube-api-key"
EMAIL_PROVIDER_API_KEY="your-email-provider-api-key"
ADMIN_NOTIFICATION_EMAIL="team@risingnation.org"
ADMIN_BOOTSTRAP_EMAIL="admin@risingnation.org"
ADMIN_BOOTSTRAP_PASSWORD="BootstrapAdminPassword123!"
RATE_LIMIT_PUBLIC_SUBMISSION_MAX=10
RATE_LIMIT_LOGIN_MAX=5
SENTRY_DSN=""
